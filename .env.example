# SaarthiFlow Environment Configuration

# Server Port
PORT=3001

# Gemini AI API Configuration
# Get your API key from https://aistudio.google.com/
GEMINI_API_KEY=YOUR_API_KEY
GEMINI_MODEL=gemini-1.5-flash

# Supabase PostgreSQL Configuration (Optional)
# If left blank, SaarthiFlow operates automatically with reliable local persistent JSON storage.
# To connect to your Supabase project, execute supabase/schema.sql in Supabase SQL editor, then supply:
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Frontend Vite API Base URL (passed to frontend during build / dev)
VITE_API_URL=http://localhost:3001/api
